// Model-lineage compat for "openai"; regenerated from the frozen census using class taxonomy selectors.

class "openai" {
	// Replaces the o-series mandatory-reasoning fallback. o-series and GPT-5+
	// reject explicit sampling params (`temperature`, `top_p`) with a 400 on
	// every serving host (#5606), whichever API fronts them.
	family "o-series" {
		thinking-requires-effort #true
		supports-sampling-params #false
	}
	revision ">=5" {
		supports-sampling-params #false
	}
	// GPT wire ladders are model generations, not host contracts: <5.2 keeps
	// the classic four-tier scale, 5.2+ drops minimal for xhigh, and 5.6+
	// exposes the wire-exact five-tier low..max scale.
	family "gpt" {
		revision "<5.2" {
			thinking-efforts "minimal" "low" "medium" "high"
		}
	}
	family "codex" {
		revision "<5.2" {
			thinking-efforts "minimal" "low" "medium" "high"
		}
		revision "=5.1" {
			models "*codex-mini*" {
				thinking-efforts "medium" "high"
			}
		}
	}
	revision ">=5.2 <5.6" {
		thinking-efforts "low" "medium" "high" "xhigh"
	}
	revision ">=5.6" {
		thinking-efforts "low" "medium" "high" "xhigh" "max"
		requires-reasoning-off-juice-instruction #true
	}
	// Delegation appetite is a lineage trait. GPT-5.6 was trained on Codex's
	// "no subagents unless asked" developer message; GPT-6 fans out on its own
	// and over-delegates under Claude-calibrated prompts (reflexive scouts,
	// single-agent babysitting), so it gets the restrained tier instead.
	revision "=5.6" {
		delegation-bias "gated"
	}
	// GPT-6 accepts `response.steer` over the Responses WebSocket: user input
	// joins the in-flight response instead of waiting for the next request.
	revision ">=6" {
		delegation-bias "restrained"
		supports-steering #true
	}
	// GPT-6 Astra changes reasoning effort mid-conversation through a
	// `configuration_update` input item so the request-level effort (and the
	// cached prompt prefix) stays put; every other SKU 400s on the item type.
	models "gpt-6-astra" {
		supports-configuration-update #true
	}
	// Codex SKUs: the advertised 400K figure includes the output budget; the
	// true prompt window is 272K. Spark budgets are its own family's.
	family "codex" {
		revision ">=1" {
			limits-patch {
				context-window 272000
			}
		}
	}
}

// Hosted Responses tools are a GPT-5+ lineage capability on any
// Responses-compatible host, so proxies exposing these ids inherit them. The
// swap targets resolve on the same provider only; when a host lacks them the
// session model runs the tool itself.
class "openai" {
	on-api "openai-responses" {
		revision ">=5" {
			web-search "openai"
			web-search-model "gpt-5.6-luna"
			hosted-image #true
			image-model "gpt-image-2"
		}
	}
	on-api "openai-codex-responses" {
		revision ">=5" {
			web-search-model "gpt-5.6-luna"
			hosted-image #true
			image-model "gpt-image-2"
		}
	}
}

// Image billing per model line, from OpenAI's vision guide (multipliers,
// per-model `detail` sizing, tile rates):
// https://developers.openai.com/api/docs/guides/images-vision#calculating-costs
// GPT-5.2+ covers images in 32px patches x 1.2. Measured on nine Codex models
// (gpt-5.5 through gpt-6.1-sol and daybreak) with a 1568px frame
// (+2,877..2,885 input tokens, formula 2,882) and a 1932px frame
// (+4,390..4,396, formula 4,392). GPT-5/5.1, GPT-4o/4.1 and o1/o3 bill legacy
// 512px tiles; the small SKUs carry their own patch multipliers. Pre-5.2
// Codex SKUs are not in the guide, so they keep no rule (callers fall back to
// their own estimate).
class "openai" {
	// gpt-5.6 sizing; the guide does not list gpt-6 sol/luna or gpt-6.1, which
	// bill like gpt-5.6 and astra at every measured size.
	revision ">=5.6" {
		image-tokenization {
			regime "openai-patch"
			multiplier 1.2
			auto "original"
			low {
				max-edge 512
			}
			high {
				max-edge 2048
				patch-budget 2500
			}
			original {
				max-edge 65535
			}
		}
	}
	revision "=5.5" {
		image-tokenization {
			regime "openai-patch"
			multiplier 1.2
			auto "original"
			low {
				max-edge 512
			}
			high {
				max-edge 2048
				patch-budget 2500
			}
			original {
				max-edge 6000
				patch-budget 10000
			}
		}
	}
	// gpt-5.4: `auto` sizes like `high`, and `low` keeps a 6,144-patch budget.
	revision "=5.4" {
		image-tokenization {
			regime "openai-patch"
			multiplier 1.2
			auto "high"
			low {
				max-edge 2048
				patch-budget 6144
			}
			high {
				max-edge 2048
				patch-budget 2500
			}
			original {
				max-edge 6000
				patch-budget 10000
			}
		}
	}
	// gpt-5.2 (and the 5.3 Codex SKU) size every level the same way.
	revision ">=5.2 <5.4" {
		image-tokenization {
			regime "openai-patch"
			multiplier 1.2
			auto "high"
			low {
				max-edge 2048
				patch-budget 6144
			}
			high {
				max-edge 2048
				patch-budget 6144
			}
			original {
				max-edge 2048
				patch-budget 6144
			}
		}
	}
	family "gpt" {
		revision ">=5 <5.2" {
			image-tokenization {
				regime "openai-tile"
				base-tokens 70
				tile-tokens 140
			}
		}
		revision "=4.1" {
			image-tokenization {
				regime "openai-tile"
				base-tokens 85
				tile-tokens 170
			}
		}
	}
	family "o-series" {
		image-tokenization {
			regime "openai-tile"
			base-tokens 75
			tile-tokens 150
		}
	}
	// residue: astra's limits differ from the rest of its revision, the
	// mini/nano SKUs share their generation's revision but not its image rule,
	// and gpt-4o carries no parsed revision. The guide's sizing table covers
	// gpt-4.1-mini only; the other small SKUs are assumed to size like it.
	models "*gpt-6-astra*" {
		image-tokenization {
			regime "openai-patch"
			multiplier 1.2
			auto "original"
			low {
				max-edge 512
			}
			high {
				max-edge 65535
				patch-budget 2500
			}
			original {
				max-edge 65535
			}
		}
	}
	models "*gpt-5-mini*" {
		image-tokenization {
			regime "openai-patch"
			multiplier 1.2
			auto "high"
			low {
				max-edge 2048
				patch-budget 6144
			}
			high {
				max-edge 2048
				patch-budget 6144
			}
			original {
				max-edge 2048
				patch-budget 6144
			}
		}
	}
	models "*gpt-5-nano*" {
		image-tokenization {
			regime "openai-patch"
			multiplier 1.5
			auto "high"
			low {
				max-edge 2048
				patch-budget 6144
			}
			high {
				max-edge 2048
				patch-budget 6144
			}
			original {
				max-edge 2048
				patch-budget 6144
			}
		}
	}
	models "*gpt-4.1-mini*" {
		image-tokenization {
			regime "openai-patch"
			multiplier 1.62
			auto "high"
			low {
				max-edge 2048
				patch-budget 6144
			}
			high {
				max-edge 2048
				patch-budget 6144
			}
			original {
				max-edge 2048
				patch-budget 6144
			}
		}
	}
	models "*gpt-4.1-nano*" {
		image-tokenization {
			regime "openai-patch"
			multiplier 2.46
			auto "high"
			low {
				max-edge 2048
				patch-budget 6144
			}
			high {
				max-edge 2048
				patch-budget 6144
			}
			original {
				max-edge 2048
				patch-budget 6144
			}
		}
	}
	models "*o4-mini*" {
		image-tokenization {
			regime "openai-patch"
			multiplier 1.72
			auto "high"
			low {
				max-edge 2048
				patch-budget 6144
			}
			high {
				max-edge 2048
				patch-budget 6144
			}
			original {
				max-edge 2048
				patch-budget 6144
			}
		}
	}
	models "*gpt-4o*" {
		image-tokenization {
			regime "openai-tile"
			base-tokens 85
			tile-tokens 170
		}
	}
	models "*gpt-4o-mini*" priority=1 {
		image-tokenization {
			regime "openai-tile"
			base-tokens 2833
			tile-tokens 5667
		}
	}
}
